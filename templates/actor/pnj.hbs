<div class="adc-pnj adc-feuille">
<header class="adc-f-entete" style="background-image:url('{{assets}}/fiche/filigrane.webp')">
  <img class="adc-f-logo" src="{{assets}}/ornements/logo.webp" alt="L'Ange du Chaos" onerror="this.remove()">
  <img class="adc-f-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage">
  <div class="adc-f-entetecorps">
    <input class="adc-f-nomperso" type="text" name="name" value="{{actor.name}}" placeholder="Nom">
    <div class="adc-f-entetelig">
      <label>Type d'ennemi <select name="system.categorie">{{selectOptions categories selected=system.categorie}}</select></label>
      {{#if system.espece}}<span class="adc-f-tag">{{system.espece}}</span>{{/if}}
      <span>Talents d'adversaire : <b>{{talentsMax}}</b></span>
      {{#if estCreature}}
      <label>Espèce <input type="text" name="system.espece" value="{{system.espece}}"></label>
      <label>Plan <input type="text" name="system.plan" value="{{system.plan}}"></label>
      {{/if}}
    </div>
  </div>
</header>
<div class="adc-f-pages">
  <h2 class="adc-f-titre large">Caractéristiques</h2>
  <div class="adc-f-caracs">
    {{#each caracsListe}}<label class="c"><b>{{this.label}}</b><input type="number" name="system.caracs.{{this.cle}}" value="{{this.valeur}}" min="0"></label>{{/each}}
  </div>

  <div class="adc-f-haut">
    <div class="adc-f-colperso">
      <h2 class="adc-f-titre">Attaque <a class="adc-f-mini adc-f-gros" data-action="attaquer" data-tooltip="Attaquer (cible désignée)"><i class="fa-solid fa-khanda"></i></a></h2>
      <div class="adc-f-pt"><label>Arme : <input class="l" type="text" name="system.attaque.nom" value="{{system.attaque.nom}}"></label></div>
      <div class="adc-f-pt">
        <label>Score d'attaque : <input class="c" type="number" name="system.attaque.score" value="{{system.attaque.score}}"></label>
        <label>Dégâts : <input class="l" type="text" name="system.attaque.degats" value="{{system.attaque.degats}}"></label>
      </div>
      <div class="adc-f-pt"><label>Capacités : <input class="l" type="text" name="system.attaque.note" value="{{system.attaque.note}}"></label></div>
      {{#each system.attaquesSup}}
      <div class="adc-f-pt adc-f-sup">
        <a class="adc-f-mini" data-action="attaquer" data-sup="{{@index}}" data-tooltip="Attaquer avec {{this.nom}}"><i class="fa-solid fa-khanda"></i></a>
        <input class="l" type="text" name="system.attaquesSup.{{@index}}.nom" value="{{this.nom}}">
        <input class="c" type="number" name="system.attaquesSup.{{@index}}.score" value="{{this.score}}">
        <input class="l" type="text" name="system.attaquesSup.{{@index}}.degats" value="{{this.degats}}">
        <a class="adc-f-btn" data-action="removeAttaque" data-index="{{@index}}" data-tooltip="Retirer"><i class="fa-solid fa-trash"></i></a>
      </div>
      {{/each}}
      <div class="adc-f-pt"><a class="adc-f-mini" data-action="addAttaque" data-tooltip="Ajouter une attaque"><i class="fa-solid fa-plus"></i> Autre attaque</a></div>

      <h2 class="adc-f-titre large">Compétences <a class="adc-f-mini adc-f-gros" data-action="addCompetence" data-tooltip="Ajouter une compétence"><i class="fa-solid fa-plus"></i></a></h2>
      <ul class="adc-f-liste">
        {{#each system.competences}}
        <li class="adc-f-ligne">
          <input class="adc-f-compnomchamp" type="text" name="system.competences.{{@index}}.nom" value="{{this.nom}}">
          <span class="adc-f-case-val"><input type="number" name="system.competences.{{@index}}.score" value="{{this.score}}"></span>
          <a class="adc-f-btn" data-action="removeCompetence" data-index="{{@index}}" data-tooltip="Retirer"><i class="fa-solid fa-trash"></i></a>
        </li>
        {{else}}<li class="adc-f-vide">Aucune compétence : utilisez le + pour en ajouter.</li>{{/each}}
      </ul>
    </div>

    <div class="adc-f-colmid">
      <h2 class="adc-f-titre">Endurance</h2>
      <div class="adc-f-jauge"><div class="adc-f-case-val">
        <input type="number" name="system.endurance.value" value="{{system.endurance.value}}" min="0"><small>/</small>
        <input type="number" name="system.endurance.max" value="{{system.endurance.max}}" min="0">
      </div></div>
      <div class="adc-f-carac"><span class="adc-f-sous">Seuil de fatigue</span><span class="adc-f-case-val"><input type="number" name="system.seuilFatigue" value="{{system.seuilFatigue}}" min="0"></span></div>
      <div class="adc-f-carac"><span class="adc-f-sous">Protection <input class="adc-f-protnom" type="text" name="system.protectionNom" value="{{system.protectionNom}}" placeholder="(nom)"></span><span class="adc-f-case-val"><input type="number" name="system.protection" value="{{system.protection}}" min="0"></span></div>
      <div class="adc-f-carac"><span class="adc-f-sous">Défense passive</span><span class="adc-f-case-val"><input type="number" name="system.defensePassive" value="{{system.defensePassive}}"></span></div>
    </div>

    <div class="adc-f-coldroite">
      <h2 class="adc-f-titre">Combat</h2>
      <div class="adc-f-carac"><span class="adc-f-sous">Initiative</span><span class="adc-f-case-val"><input type="number" name="system.initiative" value="{{system.initiative}}"></span></div>
      <div class="adc-f-carac"><span class="adc-f-sous">Mouvement</span><span class="adc-f-case-val"><input type="number" name="system.mouvement" value="{{system.mouvement}}" min="0"></span></div>
      <div class="adc-f-carac"><span class="adc-f-sous">Actions par tour</span><span class="adc-f-case-val"><input type="number" name="system.actions" value="{{system.actions}}" min="1"></span></div>
      <div class="adc-f-carac"><span class="adc-f-sous">Nexus</span><span class="adc-f-case-val"><input type="number" name="system.nexus" value="{{system.nexus}}" min="0"></span></div>
      <div class="adc-f-carac"><span class="adc-f-sous">Réaction</span><span class="adc-f-case-val"><input type="checkbox" name="system.reaction" {{checked system.reaction}}></span></div>
      <div class="adc-f-carac"><span class="adc-f-sous">Arts étranges</span><span class="adc-f-case-val"><input type="number" name="system.artsEtranges" value="{{system.artsEtranges}}" min="0"></span></div>
      <div class="adc-f-carac"><span class="adc-f-sous">Bonus aux dégâts</span><span class="adc-f-case-val"><input type="number" name="system.bonusDegats" value="{{system.bonusDegats}}"></span></div>
    </div>
  </div>

  <h2 class="adc-f-titre large">Description</h2>
  {{formInput champs.description value=system.description enriched=enrichi.description toggled=true}}
  <h2 class="adc-f-titre large">Talents d'adversaire</h2>
  {{formInput champs.talents value=system.talents enriched=enrichi.talents toggled=true}}
  {{#if estCreature}}
  <h2 class="adc-f-titre large">Capacités spéciales</h2>
  {{formInput champs.capacites value=system.capacites enriched=enrichi.capacites toggled=true}}
  {{/if}}

  {{#each sectionsListe}}
  <div class="adc-f-bloc" data-type="{{this.type}}">
    <h2 class="adc-f-titre large">{{this.titre}}</h2>
    <ul class="adc-f-liste">
      {{#each this.lignes}}{{> adc-ligne-f}}{{else}}<li class="adc-f-vide">Glissez ici : {{../titre}}</li>{{/each}}
    </ul>
  </div>
  {{/each}}
</div>
</div>
