<div class="adc-pnj adc-feuille">
<header class="adc-f-entete" style="background-image:url('{{assets}}/fiche/filigrane.webp')">
  <img class="adc-f-logo" src="{{assets}}/ornements/logo.webp" alt="L'Ange du Chaos" onerror="this.remove()">
  <img class="adc-f-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage">
  <div class="adc-f-entetecorps">
    <input class="adc-f-nomperso" type="text" name="name" value="{{actor.name}}" placeholder="Nom">
    <div class="adc-f-entetelig">
      <label>Type d'ennemi <select name="system.categorie">{{selectOptions categories selected=system.categorie}}</select></label>
      {{#if system.espece}}<span class="adc-f-tag">{{system.espece}}</span>{{/if}}
      <span>Talents d'adversaire : <b>{{talentsMax}}</b></span>
      {{#if estCreature}}
      <label>Espèce <input type="text" name="system.espece" value="{{system.espece}}"></label>
      <label>Plan <input type="text" name="system.plan" value="{{system.plan}}"></label>
      {{/if}}
    </div>
  </div>
</header>
<nav class="adc-f-onglets">
  {{#each onglets}}
  <a class="adc-tab adc-f-onglet {{#if this.actif}}active{{/if}}" data-action="adcOnglet" data-tab="{{this.id}}"><img src="{{this.icone}}" alt="" onerror="this.remove()"><span>{{this.label}}</span></a>
  {{/each}}
</nav>
<div class="adc-f-pages">
<section class="adc-onglet tab adc-f-page" data-tab="profil">
  <div class="adc-p2-vitaux">
    <div class="adc-p2-tuile fin"><span class="adc-p2-lib">Endurance</span>
      <span class="adc-p2-val"><input type="number" name="system.endurance.value" value="{{system.endurance.value}}" min="0"><small>/</small><input type="number" name="system.endurance.max" value="{{system.endurance.max}}" min="0"></span>
      <span class="adc-p2-barre"><i style="width:{{pctEndurance}}%"></i></span></div>
    <div class="adc-p2-tuile"><span class="adc-p2-lib">Seuil de fatigue</span>
      <span class="adc-p2-val"><input type="number" name="system.seuilFatigue" value="{{system.seuilFatigue}}" min="0"></span><span class="adc-p2-sous">Réaction : 3 END</span></div>
    <div class="adc-p2-tuile"><span class="adc-p2-lib">Défense passive</span>
      <span class="adc-p2-val"><input type="number" name="system.defensePassive" value="{{system.defensePassive}}"></span></div>
    <div class="adc-p2-tuile"><span class="adc-p2-lib">Protection</span>
      <span class="adc-p2-val"><input type="number" name="system.protection" value="{{system.protection}}" min="0"></span>
      <input class="adc-p2-sous" type="text" name="system.protectionNom" value="{{system.protectionNom}}" placeholder="(nom)"></div>
  </div>

  <div class="adc-p2-caracs">
    {{#each caracsListe}}<label class="adc-p2-med"><span class="adc-p2-rond"><input type="number" name="system.caracs.{{this.cle}}" value="{{this.valeur}}" min="0"></span><b>{{this.label}}</b><small>{{this.nom}}</small></label>{{/each}}
  </div>
  <div class="adc-p2-puces">
    <label class="adc-p2-puce"><span>Initiative</span><input type="number" name="system.initiative" value="{{system.initiative}}"></label>
    <label class="adc-p2-puce"><span>Mouvement</span><input type="number" name="system.mouvement" value="{{system.mouvement}}" min="0"></label>
    <label class="adc-p2-puce"><span>Actions / tour</span><input type="number" name="system.actions" value="{{system.actions}}" min="1"></label>
    <label class="adc-p2-puce"><span>Bonus dégâts</span><input type="number" name="system.bonusDegats" value="{{system.bonusDegats}}"></label>
    <label class="adc-p2-puce"><span>Nexus</span><input type="number" name="system.nexus" value="{{system.nexus}}" min="0"></label>
    <label class="adc-p2-puce"><span>Arts étranges</span><input type="number" name="system.artsEtranges" value="{{system.artsEtranges}}" min="0"></label>
    <label class="adc-p2-puce"><span>Réaction</span><input type="checkbox" name="system.reaction" {{checked system.reaction}}></label>
  </div>

</section>
<section class="adc-onglet tab adc-f-page" data-tab="combat">
  <h2 class="adc-f-titre large">Attaques <a class="adc-f-mini adc-f-gros" data-action="addAttaque" data-tooltip="Ajouter une attaque"><i class="fa-solid fa-plus"></i></a></h2>
  <table class="adc-p2-att">
    <thead><tr><th>Arme</th><th>Score</th><th>Dégâts</th><th>Capacités</th><th></th></tr></thead>
    <tbody>
      <tr>
        <td><input class="n" type="text" name="system.attaque.nom" value="{{system.attaque.nom}}" placeholder="Arme"></td>
        <td><input class="s" type="number" name="system.attaque.score" value="{{system.attaque.score}}"></td>
        <td><input type="text" name="system.attaque.degats" value="{{system.attaque.degats}}"></td>
        <td><input type="text" name="system.attaque.note" value="{{system.attaque.note}}"></td>
        <td class="b"><a class="adc-p2-go" data-action="attaquer" data-tooltip="Attaquer (cible désignée)"><i class="fa-solid fa-khanda"></i> Attaquer</a></td>
      </tr>
      {{#each system.attaquesSup}}
      <tr>
        <td><input class="n" type="text" name="system.attaquesSup.{{@index}}.nom" value="{{this.nom}}"></td>
        <td><input class="s" type="number" name="system.attaquesSup.{{@index}}.score" value="{{this.score}}"></td>
        <td><input type="text" name="system.attaquesSup.{{@index}}.degats" value="{{this.degats}}"></td>
        <td><input type="text" name="system.attaquesSup.{{@index}}.note" value="{{this.note}}"></td>
        <td class="b"><a class="adc-p2-go" data-action="attaquer" data-sup="{{@index}}" data-tooltip="Attaquer avec {{this.nom}}"><i class="fa-solid fa-khanda"></i> Attaquer</a>
          <a class="adc-f-btn" data-action="removeAttaque" data-index="{{@index}}" data-tooltip="Retirer"><i class="fa-solid fa-trash"></i></a></td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="adc-f-repli" data-repli="comps">
  <h2 class="adc-f-titre large adc-f-replitit" data-action="replier" data-cle="comps" data-tooltip="Cliquer pour replier / déplier">Compétences<a class="adc-f-mini adc-f-gros" data-action="addCompetence" data-tooltip="Ajouter une compétence"><i class="fa-solid fa-plus"></i></a> <i class="fa-solid fa-chevron-down adc-f-chev"></i></h2>
  <div class="adc-p2-comps">
    {{#each system.competences}}
    <div class="adc-p2-comp">
      <input type="text" name="system.competences.{{@index}}.nom" value="{{this.nom}}">
      <input class="v" type="number" name="system.competences.{{@index}}.score" value="{{this.score}}">
      <a class="adc-f-btn" data-action="removeCompetence" data-index="{{@index}}" data-tooltip="Retirer"><i class="fa-solid fa-trash"></i></a>
    </div>
    {{else}}<p class="adc-f-vide">Aucune compétence : utilisez le + pour en ajouter.</p>{{/each}}
  </div>
  </div>

</section>
<section class="adc-onglet tab adc-f-page" data-tab="biographie">
  <div class="adc-f-repli" data-repli="description">
  <h2 class="adc-f-titre large adc-f-replitit" data-action="replier" data-cle="description" data-tooltip="Cliquer pour replier / déplier">Description <i class="fa-solid fa-chevron-down adc-f-chev"></i></h2>
  {{formInput champs.description value=system.description enriched=enrichi.description toggled=true}}
  </div>
  <div class="adc-f-repli" data-repli="talentsAdv">
  <h2 class="adc-f-titre large adc-f-replitit" data-action="replier" data-cle="talentsAdv" data-tooltip="Cliquer pour replier / déplier">Talents d'adversaire <i class="fa-solid fa-chevron-down adc-f-chev"></i></h2>
  {{formInput champs.talents value=system.talents enriched=enrichi.talents toggled=true}}
  </div>
  {{#if estCreature}}
  <div class="adc-f-repli" data-repli="capacites">
  <h2 class="adc-f-titre large adc-f-replitit" data-action="replier" data-cle="capacites" data-tooltip="Cliquer pour replier / déplier">Capacités spéciales <i class="fa-solid fa-chevron-down adc-f-chev"></i></h2>
  {{formInput champs.capacites value=system.capacites enriched=enrichi.capacites toggled=true}}
  </div>
  {{/if}}

</section>
<section class="adc-onglet tab adc-f-page" data-tab="equipement">
  {{#each sectionsListe}}
  <div class="adc-f-bloc adc-f-repli" data-repli="sec-{{this.type}}" data-type="{{this.type}}">
    <h2 class="adc-f-titre large adc-f-replitit" data-action="replier" data-cle="sec-{{this.type}}" data-tooltip="Cliquer pour replier / déplier">{{this.titre}} <i class="fa-solid fa-chevron-down adc-f-chev"></i></h2>
    <ul class="adc-f-liste">
      {{#each this.lignes}}{{> adc-ligne-f}}{{else}}<li class="adc-f-vide">Glissez ici : {{../titre}}</li>{{/each}}
    </ul>
  </div>
  {{/each}}
</section>
</div>
</div>
