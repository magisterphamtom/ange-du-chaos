<div class="adc-section" data-type="{{sec.type}}">
  <h3>{{sec.titre}}</h3>
  <ul class="adc-liste">
    {{#each sec.lignes}}
    <li class="adc-ligne" data-item-id="{{this.id}}" draggable="true">
      {{#if this.rune}}<img class="adc-rune" src="{{this.rune}}" alt="" onerror="this.remove()">{{/if}}
      <img class="adc-ligne-img" src="{{this.img}}" alt="" data-action="openItem">
      <a class="adc-ligne-nom" data-action="openItem">{{this.name}}</a>
      <span class="adc-ligne-resume">{{this.resume}}</span>
      {{#if this.lancable}}<a class="adc-btn" data-action="lancerSort" data-tooltip="Lancer le sort"><i class="fa-solid fa-wand-sparkles"></i></a>{{/if}}
      {{#if this.attaquable}}<a class="adc-btn adc-btn-attaque" data-action="attaquer" data-tooltip="Attaquer avec cette arme"><i class="fa-solid fa-khanda"></i></a>{{/if}}
      {{#if this.equipable}}
      <a class="adc-btn {{#if this.equipee}}actif{{/if}}" data-action="toggleEquip" data-tooltip="{{#if this.equipee}}Équipé{{else}}Non équipé{{/if}}"><i class="fa-solid fa-shield-halved"></i></a>
      {{/if}}
      <a class="adc-btn" data-action="deleteItem" data-tooltip="Supprimer"><i class="fa-solid fa-trash"></i></a>
    </li>
    {{else}}
    <li class="adc-vide">Glissez ici : {{sec.titre}}</li>
    {{/each}}
  </ul>
</div>
