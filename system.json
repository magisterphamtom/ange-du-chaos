{
  "id": "ange-du-chaos",
  "title": "L'Ange du Chaos",
  "description": "Système de jeu Foundry VTT pour « L'Ange du Chaos », le jeu de rôle des éditions Les XII Singes (d'après les romans de Michel Robert). Code seul : les illustrations et les textes du livre ne sont pas inclus.",
  "version": "0.27.0",
  "compatibility": { "minimum": "13", "verified": "14.369" },
  "authors": [{ "name": "magisterphamtom" }],
  "url": "https://github.com/magisterphamtom/ange-du-chaos",
  "bugs": "https://github.com/magisterphamtom/ange-du-chaos/issues",
  "manifest": "https://github.com/magisterphamtom/ange-du-chaos/releases/latest/download/system.json",
  "download": "https://github.com/magisterphamtom/ange-du-chaos/releases/download/v0.23.1/ange-du-chaos.zip",
  "esmodules": ["module/ange-du-chaos.mjs"],
  "styles": ["css/ange-du-chaos.css", "css/fiche.css", "css/dialogues.css"],
  "languages": [{ "lang": "fr", "name": "Français", "path": "lang/fr.json" }],
  "documentTypes": {
    "Actor": {
      "personnage": { "htmlFields": ["biographie.historique", "biographie.physionomie", "biographie.personnalite", "notes"] },
      "pnj": { "htmlFields": ["description", "talents", "notes"] },
      "creature": { "htmlFields": ["description", "talents", "notes", "capacites"] }
    },
    "Item": {
      "arme": { "htmlFields": ["description"] },
      "armure": { "htmlFields": ["description"] },
      "bouclier": { "htmlFields": ["description"] },
      "equipement": { "htmlFields": ["description"] },
      "drogue": { "htmlFields": ["description", "effets"] },
      "sort": { "htmlFields": ["description", "effet"] },
      "artmartial": { "htmlFields": ["description", "effetPermanent.description", "coupSpecial.description"] },
      "talent": { "htmlFields": ["description", "paliers"] },
      "fortune": { "htmlFields": ["description"] },
      "malediction": { "htmlFields": ["description"] },
      "maison": { "htmlFields": ["description", "competences", "talentsSecrets"] },
      "voie": { "htmlFields": ["description", "competences", "talent"] },
      "rune": { "htmlFields": ["description", "effet"] },
      "gemmelite": { "htmlFields": ["description", "effet"] },
      "maladie": { "htmlFields": ["description", "effet"] }
    }
  },
  "grid": { "distance": 1, "units": "m" },
  "primaryTokenAttribute": "endurance",
  "secondaryTokenAttribute": "mana",
  "socket": true,
  "flags": {}
}
